# =============================================================================
# VisionMacro Backend — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your actual API keys.
#
# cp .env.example .env
# =============================================================================

# --- Gemini AI (FREE version) ---
# Get your FREE key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- Edamam Nutrition API (required for macro calculation) ---
# Sign up at: https://developer.edamam.com/edamam-nutrition-api
EDAMAM_APP_ID=your-edamam-app-id
EDAMAM_APP_KEY=your-edamam-app-key

# --- Firebase (required for data persistence) ---
# You can use either a full service account JSON string or Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}

# --- App ---
APP_NAME=VisionMacro API
DEBUG=true
